---
const title = "dclaw — sandboxed AI agents in containers";
const description = "Container-native multi-agent platform with mandatory sandboxing, independently versioned channel plugins, and a control-plane / data-plane split.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dclaw.dev" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col">
    <main class="flex-1 flex items-center justify-center px-6 py-16">
      <div class="max-w-2xl w-full">
        <h1 class="text-5xl sm:text-6xl font-bold tracking-tight mb-4">
          <span class="text-white">d</span><span class="text-zinc-400">claw</span>
        </h1>
        <p class="text-xl text-zinc-300 mb-2">
          Sandboxed AI agents in containers.
        </p>
        <p class="text-base text-zinc-500 mb-10">
          Container-native multi-agent platform with mandatory sandboxing,
          independently versioned channel plugins, and a control-plane / data-plane split.
        </p>

        <div class="flex flex-wrap gap-4 mb-10">
          <a
            href="https://github.com/itsmehatef/dclaw"
            class="inline-flex items-center px-5 py-2.5 rounded-md bg-white text-black font-medium hover:bg-zinc-200 transition"
          >
            GitHub
            <svg class="w-4 h-4 ml-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
          <a
            href="https://github.com/itsmehatef/dclaw/blob/main/docs/architecture.md"
            class="inline-flex items-center px-5 py-2.5 rounded-md border border-zinc-700 text-zinc-100 font-medium hover:bg-zinc-900 transition"
          >
            Architecture
          </a>
          <a
            href="https://github.com/itsmehatef/dclaw/blob/main/docs/wire-protocol-spec.md"
            class="inline-flex items-center px-5 py-2.5 rounded-md border border-zinc-700 text-zinc-100 font-medium hover:bg-zinc-900 transition"
          >
            Wire Protocol
          </a>
        </div>

        <div class="border-t border-zinc-800 pt-6 text-sm text-zinc-500">
          <p class="mb-1">
            <span class="font-mono bg-zinc-900 px-2 py-0.5 rounded text-zinc-300">v0.1.0</span>
            — Phase 1 MVP: one agent loop working inside a container.
          </p>
          <p>
            Built by <a href="https://realhatefk.me" class="text-zinc-300 hover:text-white underline">Hatef</a>.
            Apache-2.0 licensed.
          </p>
        </div>
      </div>
    </main>

    <footer class="border-t border-zinc-900 py-6 px-6 text-sm text-zinc-600">
      <div class="max-w-2xl mx-auto flex flex-wrap justify-between gap-4">
        <span>dclaw</span>
        <div class="flex gap-4">
          <a href="https://github.com/itsmehatef/dclaw" class="hover:text-zinc-400">GitHub</a>
          <a href="https://realhatefk.me" class="hover:text-zinc-400">Blog</a>
        </div>
      </div>
    </footer>
  </body>
</html>
