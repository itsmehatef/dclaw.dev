---
const REGIONS: Record<string, { label: string; desc: string }> = {
  user:    { label: "user",         desc: "Discord, Slack, WhatsApp messages enter here. Each channel is a versioned plugin container." },
  plugin:  { label: "channel plugins", desc: "Independently versioned containers — discord v1.5, slack v2.0, whatsapp v0.8. Roll one without touching others." },
  ops:     { label: "operational surface", desc: "fleet.yaml declarative config · dclaw CLI (Go) · web dashboard (TypeScript). What you actually touch." },
  daemon:  { label: "dclaw daemon", desc: "Go control plane on host. Channel router · fleet manager · quota enforcement · agent registry (SQLite)." },
  main:    { label: "main agent",   desc: "Always-on container · ~400MB · DATA PLANE. Calls the configured LLM, holds conversation, runs sandboxed bash/file/grep/web tools." },
  workers: { label: "worker agents", desc: "Ephemeral · ~400MB each · DATA PLANE. Spawned per task with scoped tools, network, workspace. Destroyed when done." },
  ext:     { label: "llm provider", desc: "External — Anthropic, OpenAI, Google, OpenRouter, or any pi-mono-supported endpoint. Only the data plane talks to this; daemon never makes LLM calls." },
};
---

<div class="diagram" data-diagram>
  <div class="diagram-header">
    <span>./architecture · v2 · hover to explore</span>
    <div class="dots"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
  </div>

  <div class="diagram-stage">
    <svg class="dg-arrows" data-arrows aria-hidden="true"></svg>

    <div class="dg-row dg-row-top">
      <div class="dg-block dg-user" data-region="user" data-anchor="user">
        <div class="dg-block-label">USER</div>
        <div class="dg-block-name">Discord · Slack · WhatsApp</div>
      </div>
      <div class="dg-block dg-ext" data-region="ext" data-anchor="ext">
        <div class="dg-block-label">LLM PROVIDER · EXTERNAL</div>
        <div class="dg-block-name">Anthropic · OpenAI · Google · …</div>
      </div>
      <div class="dg-block dg-ops" data-region="ops" data-anchor="ops">
        <div class="dg-block-label">OPERATIONAL SURFACE</div>
        <div class="dg-block-name">CLI · fleet.yaml · web</div>
      </div>
    </div>

    <div class="dg-band dg-plugin on" data-region="plugin" data-anchor="plugin">
      <div class="dg-band-tag">CHANNEL PLUGINS · independently versioned containers</div>
      <div class="dg-pills">
        <span class="dg-pill">discord v1.5.0</span>
        <span class="dg-pill">slack v2.0.3</span>
        <span class="dg-pill">whatsapp v0.8.2</span>
      </div>
    </div>

    <div class="dg-band dg-daemon on" data-region="daemon" data-anchor="daemon" data-default>
      <div class="dg-band-tag">dclaw DAEMON · Go · CONTROL PLANE · runs on host</div>
      <div class="dg-pills">
        <span class="dg-pill">channel router</span>
        <span class="dg-pill">fleet manager</span>
        <span class="dg-pill">quota enforce</span>
        <span class="dg-pill">agent registry · SQLite</span>
      </div>
    </div>

    <div class="dg-row dg-row-data">
      <div class="dg-block dg-main" data-region="main" data-anchor="main">
        <div class="dg-block-label">MAIN AGENT · ~400MB · DATA PLANE</div>
        <div class="dg-block-name">always-on</div>
        <div class="dg-block-sub mono">bash · file · grep · web</div>
      </div>
      <div class="dg-block dg-workers" data-region="workers" data-anchor="workers">
        <div class="dg-block-label">WORKER CONTAINERS · ~400MB ea · ephemeral</div>
        <div class="dg-block-name">w·1   w·2   w·N</div>
        <div class="dg-block-sub mono">scoped tools · scoped net · scoped fs</div>
      </div>
    </div>
  </div>

  <div class="diagram-detail">
    <b class="mono" data-detail-label>dclaw daemon</b>
    <span class="diagram-detail-text" data-detail-desc> — Go control plane on host. Channel router · fleet manager · quota enforcement · agent registry (SQLite).</span>
  </div>
</div>

<script is:inline define:vars={{ REGIONS }}>
  document.querySelectorAll('[data-diagram]').forEach((root) => {
    const labelEl = root.querySelector('[data-detail-label]');
    const descEl = root.querySelector('[data-detail-desc]');
    const blocks = root.querySelectorAll('[data-region]');
    const setActive = (id) => {
      blocks.forEach((b) => b.classList.toggle('on', b.dataset.region === id));
      const r = REGIONS[id] || REGIONS.daemon;
      labelEl.textContent = r.label;
      descEl.textContent = ' — ' + r.desc;
    };
    blocks.forEach((b) => b.addEventListener('mouseenter', () => setActive(b.dataset.region)));

    // Arrow overlay -----------------------------------------------------
    const stage = root.querySelector('.diagram-stage');
    const svg = root.querySelector('[data-arrows]');
    if (!stage || !svg) return;

    const CONNECTIONS = [
      { from: "user",    fromSide: "bottom", to: "plugin",  toSide: "top",    kind: "solid"  },
      { from: "plugin",  fromSide: "bottom", to: "daemon",  toSide: "top",    kind: "solid"  },
      { from: "daemon",  fromSide: "bottom", to: "main",    toSide: "top",    kind: "solid"  },
      { from: "main",    fromSide: "right",  to: "workers", toSide: "left",   kind: "solid"  },
      { from: "main",    fromSide: "top",    to: "ext",     toSide: "bottom", kind: "dashed" },
      { from: "ops",     fromSide: "bottom", to: "daemon",  toSide: "right",  kind: "dashed" },
    ];

    const anchorPoint = (el, side) => {
      const stageRect = stage.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      const x0 = r.left - stageRect.left;
      const y0 = r.top - stageRect.top;
      const w = r.width, h = r.height;
      switch (side) {
        case "top":    return [x0 + w / 2, y0];
        case "bottom": return [x0 + w / 2, y0 + h];
        case "left":   return [x0,         y0 + h / 2];
        case "right":  return [x0 + w,     y0 + h / 2];
      }
      return [x0 + w / 2, y0 + h / 2];
    };

    const pathBetween = (a, b, fromSide, toSide) => {
      const [ax, ay] = a, [bx, by] = b;
      // Orthogonal L-shape with mid-point bend on the dominant axis.
      if ((fromSide === "bottom" || fromSide === "top") && (toSide === "top" || toSide === "bottom")) {
        const my = (ay + by) / 2;
        return `M ${ax} ${ay} L ${ax} ${my} L ${bx} ${my} L ${bx} ${by}`;
      }
      if ((fromSide === "left" || fromSide === "right") && (toSide === "left" || toSide === "right")) {
        const mx = (ax + bx) / 2;
        return `M ${ax} ${ay} L ${mx} ${ay} L ${mx} ${by} L ${bx} ${by}`;
      }
      // Mixed: bend at fromSide axis first, then perpendicular to toSide.
      if (fromSide === "bottom" || fromSide === "top") {
        return `M ${ax} ${ay} L ${ax} ${by} L ${bx} ${by}`;
      }
      return `M ${ax} ${ay} L ${bx} ${ay} L ${bx} ${by}`;
    };

    const anchor = (key) => root.querySelector(`[data-anchor="${key}"]`);

    const render = () => {
      const stageRect = stage.getBoundingClientRect();
      svg.setAttribute("viewBox", `0 0 ${stageRect.width} ${stageRect.height}`);
      svg.setAttribute("width", stageRect.width);
      svg.setAttribute("height", stageRect.height);
      // clear
      while (svg.firstChild) svg.removeChild(svg.firstChild);
      // marker def
      const defs = document.createElementNS("http://www.w3.org/2000/svg", "defs");
      defs.innerHTML = `
        <marker id="dg-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor"></path>
        </marker>
      `;
      svg.appendChild(defs);

      CONNECTIONS.forEach((c) => {
        const fromEl = anchor(c.from);
        const toEl = anchor(c.to);
        if (!fromEl || !toEl) return;
        const a = anchorPoint(fromEl, c.fromSide);
        const b = anchorPoint(toEl, c.toSide);
        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute("d", pathBetween(a, b, c.fromSide, c.toSide));
        path.setAttribute("class", "dg-arrow-path" + (c.kind === "dashed" ? " dg-arrow-dashed" : ""));
        path.setAttribute("marker-end", "url(#dg-arrow)");
        svg.appendChild(path);
      });
    };

    render();
    let raf = 0;
    const onResize = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(render);
    };
    window.addEventListener("resize", onResize);
    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(onResize).observe(stage);
    }
    // Re-render after fonts load (size of cells may shift).
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(render);
    }
  });
</script>
